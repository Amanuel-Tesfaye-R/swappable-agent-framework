{
  "agent": {
    "name": "CoPilot",
    "version": "1.0.0",
    "activeProvider": "anthropic",
    "fallbackOrder": ["google", "openai", "ollama"],
    "antiBleedShield": true,
    "contracts": {
      "identity": "../../specs/SOUL_SPEC.md",
      "agents": "../../specs/AGENTS_SPEC.md"
    },
    "providers": {
      "anthropic": {
        "kind": "anthropic",
        "model": "claude-3-5-sonnet-20241022",
        "apiKeyEnv": "ANTHROPIC_API_KEY",
        "temperature": 0.2,
        "maxTokens": 8192
      },
      "google": {
        "kind": "google",
        "model": "gemini-2.0-flash",
        "apiKeyEnv": "GEMINI_API_KEY",
        "temperature": 0.2,
        "maxTokens": 8192
      },
      "openai": {
        "kind": "openai",
        "model": "gpt-4o",
        "apiKeyEnv": "OPENAI_API_KEY",
        "temperature": 0.2,
        "maxTokens": 4096
      },
      "ollama": {
        "kind": "ollama",
        "model": "qwen2.5-coder:32b",
        "baseURL": "http://localhost:11434"
      }
    }
  }
}
