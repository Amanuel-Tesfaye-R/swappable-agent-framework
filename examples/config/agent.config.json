{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "agent": {
    "name": "CoPilot",
    "version": "1.0.0",
    "activeProvider": "anthropic",
    "providers": {
      "anthropic": {
        "model": "claude-3-5-sonnet-20241022",
        "temperature": 0.2,
        "maxTokens": 8192
      },
      "google": {
        "model": "gemini-2.0-flash",
        "temperature": 0.2,
        "maxTokens": 8192
      },
      "openai": {
        "model": "gpt-4o",
        "temperature": 0.2,
        "maxTokens": 4096
      },
      "ollama": {
        "model": "qwen2.5-coder:32b",
        "baseURL": "http://localhost:11434"
      }
    },
    "contracts": {
      "soul": "./specs/SOUL.md",
      "identity": "./specs/IDENTITY.md",
      "system": "./specs/SYSTEM.md",
      "user": "./specs/USER.md",
      "agents": "./specs/AGENTS.md"
    }
  }
}
